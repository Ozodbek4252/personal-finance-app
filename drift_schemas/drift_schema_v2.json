  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"color_key\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)));"
        }
      ]
    },
    {
      "name": "payment_methods",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"payment_methods\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"is_custom\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_custom\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL, \"opening_balance\" INTEGER NOT NULL DEFAULT 0, \"is_archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_archived\" IN (0, 1)), \"currency\" TEXT NOT NULL DEFAULT 'uzs');"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"kind\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL CHECK(\"amount\" > 0), \"category_id\" INTEGER NOT NULL REFERENCES categories (id), \"payment_method_id\" INTEGER NOT NULL REFERENCES payment_methods (id), \"occurred_at\" INTEGER NOT NULL, \"note\" TEXT NULL, \"description\" TEXT NULL, \"receipt_path\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "exchanges",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exchanges\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"from_method_id\" INTEGER NOT NULL REFERENCES payment_methods (id), \"from_amount\" INTEGER NOT NULL CHECK(\"from_amount\" > 0), \"to_method_id\" INTEGER NOT NULL REFERENCES payment_methods (id), \"to_amount\" INTEGER NOT NULL CHECK(\"to_amount\" > 0), \"rate\" REAL NOT NULL, \"fee\" INTEGER NOT NULL DEFAULT 0, \"occurred_at\" INTEGER NOT NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "exchange_rates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exchange_rates\" (\"currency\" TEXT NOT NULL, \"day\" INTEGER NOT NULL, \"rate\" REAL NOT NULL, PRIMARY KEY (\"currency\", \"day\"));"
        }
      ]
    },
    {
      "name": "transactions_occurred_at",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX transactions_occurred_at ON transactions (occurred_at)"
        }
      ]
    },
    {
      "name": "exchanges_occurred_at",
